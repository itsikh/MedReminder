<?xml version="1.0" encoding="utf-8"?>
<!-- Custom expanded/heads-up layout for medication reminders.
     Used with DecoratedCustomViewStyle to fit 4 action buttons —
     the system template caps notification actions at 3. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="4dp">

    <TextView
        android:id="@+id/notif_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/notif_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textAppearance="@style/TextAppearance.Compat.Notification"
        android:maxLines="2"
        android:ellipsize="end" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_taken"
            style="@style/NotifActionButton"
            android:text="✅ Took it" />

        <TextView
            android:id="@+id/btn_snooze"
            style="@style/NotifActionButton" />

        <TextView
            android:id="@+id/btn_third"
            style="@style/NotifActionButton" />

        <TextView
            android:id="@+id/btn_skip"
            style="@style/NotifActionButton"
            android:text="🚫 Skip" />
    </LinearLayout>
</LinearLayout>
